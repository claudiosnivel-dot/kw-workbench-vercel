{
  "name": "seo-god-mode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "env:check": "node scripts/env-check.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "planner:export": "tsx --env-file-if-exists=.env scripts/planner-export.ts",
    "planner:import": "tsx --env-file-if-exists=.env scripts/planner-import.ts",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "knip": "knip --reporter json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:tooling": "vitest run --project tooling",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy && prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "11.4.0",
    "exceljs": "4.4.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/madge": "5.0.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jscpd": "4.3.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "madge": "8.0.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "madge": {
      "typescript": "$typescript"
    },
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "engines": {
    "node": "24.x"
  }
}
