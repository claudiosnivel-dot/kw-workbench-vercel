// Client generato in lib/generated/prisma (gitignorato): runtime senza engine Rust, quindi senza binaryTargets.
generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

// Gli URL non stanno più nello schema: la CLI legge prisma.config.ts, l'app passa l'adapter pg (lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

enum AutocompleteProvider {
  MOCK
  GOOGLE_DIRECT
}

enum MetricsProvider {
  NONE
  MOCK
  GOOGLE_KEYWORD_PLANNER
  DATAFORSEO
  PLANNER_CSV
}

enum BrandStatus {
  allowed
  excluded
  review
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum SearchIntent {
  informational
  commercial
  transactional
  navigational
  mixed
}

enum KeywordType {
  generic
  question
  comparison
  branded
  local
  tool
  service
  product
  content_topic
}

enum MetricsStatus {
  missing
  mock
  fetched
  imported
  failed
}

// Precisione del volume (T-901, D-17): exact per un numero, range per un intervallo di Keyword Planner
// importato come punto medio.
enum MetricsPrecision {
  exact
  range
}

// Sorgente del punteggio (T-707, D-18): metrics è dichiarato per primo, così l'ordinamento crescente
// mette prima le keyword con metriche reali.
enum ScoreSource {
  metrics
  heuristic
}

enum JobType {
  extraction
}

enum JobStatus {
  pending
  running
  completed
  failed
}

enum UserRole {
  ADMIN
  SUBSCRIBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ThemeMode {
  DARK
  LIGHT
}

enum FontScaleMode {
  NORMAL
  LARGE
}

enum ColorVisionMode {
  NONE
  PROTANOPIA
  DEUTERANOPIA
  TRITANOPIA
}

enum OnboardingStatus {
  NEEDS_CHOICE
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum OnboardingStep {
  WELCOME
  PROJECT_CREATE
  PROJECT_TARGETING
  SECTION_CREATE
  SEEDS
  RUN
  REVIEW_EXPORT
}

enum OnboardingEntryMode {
  NONE
  RESUME
  RESTART
}

model User {
  id                String            @id @default(cuid())
  username          String            @unique
  password_hash     String
  role              UserRole          @default(SUBSCRIBER)
  status            UserStatus        @default(ACTIVE)
  is_root_admin     Boolean           @default(false)
  last_login_at     DateTime?
  theme_mode        ThemeMode         @default(DARK)
  font_scale_mode   FontScaleMode     @default(NORMAL)
  color_vision_mode ColorVisionMode   @default(NONE)
  session_version   Int               @default(0)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  projects          Project[]
  google_sheets_credential GoogleSheetsCredential?
  onboarding_progress UserOnboardingProgress?

  @@index([role])
  @@index([status])
  @@map("users")
}

model Project {
  id                    String               @id @default(cuid())
  owner_user_id         String?
  default_subproject_id String?
  name                  String
  language_code         String               @default("en")
  country_code          String               @default("US")
  autocomplete_provider AutocompleteProvider @default(MOCK)
  metrics_provider      MetricsProvider      @default(NONE)
  min_volume            Int                  @default(0)
  exclude_brands        Boolean              @default(true)
  expand_alpha          Boolean              @default(true)
  expand_numeric        Boolean              @default(true)
  expand_patterns       Boolean              @default(true)
  auto_classification   Boolean              @default(true)
  scoring_profile       String               @default("balanced")
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  /// Ultima attività reale (estrazioni, sezioni, revisione, impostazioni): ordinamento della dashboard (T-810).
  last_activity_at      DateTime             @default(now())
  owner                 User?                @relation(fields: [owner_user_id], references: [id], onDelete: Cascade)
  subprojects           Subproject[]         @relation("ProjectSubprojects")
  default_subproject    Subproject?          @relation("ProjectDefaultSubproject", fields: [default_subproject_id], references: [id], onDelete: SetNull)
  seeds                 Seed[]
  keyword_candidates    KeywordCandidate[]
  jobs                  Job[]
  brand_blacklist       BrandBlacklist[]
  expansion_patterns    ExpansionPattern[]
  metrics_provider_requests MetricsProviderRequest[]
  onboarding_active_for_users UserOnboardingProgress[] @relation("OnboardingActiveProject")

  @@index([owner_user_id])
  @@index([default_subproject_id])
  @@map("projects")
}

model Subproject {
  id                             String               @id @default(cuid())
  project_id                     String
  name                           String
  description                    String?
  position                       Int                  @default(0)
  language_code_override         String?
  country_code_override          String?
  autocomplete_provider_override AutocompleteProvider?
  metrics_provider_override      MetricsProvider?
  min_volume_override            Int?
  exclude_brands_override        Boolean?
  expand_alpha_override          Boolean?
  expand_numeric_override        Boolean?
  expand_patterns_override       Boolean?
  auto_classification_override   Boolean?
  scoring_profile_override       String?
  created_at                     DateTime             @default(now())
  updated_at                     DateTime             @updatedAt
  project                        Project              @relation("ProjectSubprojects", fields: [project_id], references: [id], onDelete: Cascade)
  default_for_projects           Project[]            @relation("ProjectDefaultSubproject")
  seeds                          Seed[]
  keyword_candidates             KeywordCandidate[]
  jobs                           Job[]
  onboarding_active_for_users    UserOnboardingProgress[] @relation("OnboardingActiveSubproject")

  @@unique([project_id, name])
  @@index([project_id, position])
  @@map("subprojects")
}

model Seed {
  id            String     @id @default(cuid())
  project_id    String
  subproject_id String
  keyword       String
  created_at    DateTime   @default(now())
  project       Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  subproject    Subproject @relation(fields: [subproject_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([subproject_id])
  @@map("seeds")
}

model KeywordCandidate {
  id                          String          @id @default(cuid())
  project_id                  String
  subproject_id               String
  keyword                     String
  normalized_keyword          String
  canonical_keyword           String
  source                      String
  source_query                String
  brand_status                BrandStatus     @default(allowed)
  brand_reason                String?
  review_status               ReviewStatus    @default(pending)
  selected_for_export         Boolean         @default(false)
  keyword_type                KeywordType     @default(generic)
  search_intent               SearchIntent    @default(mixed)
  is_question                 Boolean         @default(false)
  is_local_intent             Boolean         @default(false)
  is_tool_intent              Boolean         @default(false)
  is_commercial_intent        Boolean         @default(false)
  metrics_status              MetricsStatus   @default(missing)
  metrics_provider            MetricsProvider @default(NONE)
  avg_monthly_searches        Int?
  competition                 Float?
  low_top_of_page_bid_micros  BigInt?
  high_top_of_page_bid_micros BigInt?
  metrics_precision           MetricsPrecision?
  score                       Float?
  score_source                ScoreSource     @default(heuristic)
  metrics_updated_at          DateTime?
  created_at                  DateTime        @default(now())
  updated_at                  DateTime        @updatedAt
  project                     Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  subproject                  Subproject      @relation(fields: [subproject_id], references: [id], onDelete: Cascade)

  @@unique([subproject_id, canonical_keyword])
  @@index([project_id, review_status])
  @@index([project_id, brand_status])
  @@index([project_id, search_intent])
  @@index([project_id, keyword_type])
  @@index([subproject_id, review_status])
  @@index([subproject_id, brand_status])
  @@index([subproject_id, search_intent])
  @@index([subproject_id, keyword_type])
  @@map("keyword_candidates")
}

model Job {
  id            String     @id @default(cuid())
  project_id    String
  subproject_id String
  type          JobType    @default(extraction)
  status        JobStatus  @default(pending)
  payload       Json?
  result        Json?
  error_message String?
  started_at    DateTime?
  completed_at  DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  project       Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  subproject    Subproject @relation(fields: [subproject_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@index([subproject_id, status])
  @@index([status, created_at])
  @@map("jobs")
}

model BrandBlacklist {
  id         String   @id @default(cuid())
  project_id String?
  brand      String
  reason     String?
  created_at DateTime @default(now())
  project    Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, brand])
  @@index([brand])
  @@map("brand_blacklist")
}

model ExpansionPattern {
  id         String   @id @default(cuid())
  project_id String?
  pattern    String
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  project    Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, pattern])
  @@map("expansion_patterns")
}

model GoogleAdsCredential {
  id                      String   @id @default(cuid())
  singleton_key           String   @unique @default("default")
  connected_email         String?
  customer_id             String?
  login_customer_id       String?
  refresh_token_encrypted String
  scope                   String?
  token_type              String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@map("google_ads_credentials")
}

model GoogleSheetsCredential {
  id                      String   @id @default(cuid())
  user_id                 String   @unique
  connected_email         String?
  refresh_token_encrypted String
  scope                   String?
  token_type              String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  user                    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("google_sheets_credentials")
}

model UserOnboardingProgress {
  id                 String            @id @default(cuid())
  user_id            String            @unique
  status             OnboardingStatus  @default(NEEDS_CHOICE)
  current_step       OnboardingStep    @default(WELCOME)
  entry_mode         OnboardingEntryMode @default(NONE)
  active_project_id  String?
  active_subproject_id String?
  first_export_at    DateTime?
  completed_at       DateTime?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  active_project     Project?          @relation("OnboardingActiveProject", fields: [active_project_id], references: [id], onDelete: SetNull)
  active_subproject  Subproject?       @relation("OnboardingActiveSubproject", fields: [active_subproject_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([current_step])
  @@index([active_project_id])
  @@index([active_subproject_id])
  @@map("user_onboarding_progress")
}

// Stato di una richiesta al fornitore di metriche (T-903): pending = prenotata, costo stimato.
enum MetricsRequestStatus {
  pending
  completed
  failed
}

/// Registro delle richieste al fornitore di metriche con licenza (T-903): tetti di spesa e limitatore tra istanze.
model MetricsProviderRequest {
  id                 String               @id @default(cuid())
  created_at         DateTime             @default(now())
  provider           MetricsProvider
  project_id         String?
  job_id             String?
  keyword_count      Int
  cost_usd           Decimal?             @db.Decimal(10, 4)
  estimated_cost_usd Decimal              @db.Decimal(10, 4)
  status             MetricsRequestStatus @default(pending)
  project            Project?             @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@map("metrics_provider_requests")
}

model AppSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value_encrypted String
  is_secret       Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("app_settings")
}





