// Client generato in lib/generated/prisma (gitignorato): runtime senza engine Rust, quindi senza binaryTargets.
generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

// Gli URL non stanno più nello schema: la CLI legge prisma.config.ts, l'app passa l'adapter pg (lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

enum AutocompleteProvider {
  MOCK
  GOOGLE_DIRECT
}

enum MetricsProvider {
  NONE
  MOCK
  DATAFORSEO
  PLANNER_CSV
}

enum BrandStatus {
  allowed
  excluded
  review
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum SearchIntent {
  informational
  commercial
  transactional
  navigational
  mixed
}

enum KeywordType {
  generic
  question
  comparison
  branded
  local
  tool
  service
  product
  content_topic
}

enum MetricsStatus {
  missing
  mock
  fetched
  imported
  failed
}

// Precisione del volume (T-901, D-17): exact per un numero, range per un intervallo di Keyword Planner
// importato come punto medio.
enum MetricsPrecision {
  exact
  range
}

// Sorgente del punteggio (T-707, D-18): metrics è dichiarato per primo, così l'ordinamento crescente
// mette prima le keyword con metriche reali.
enum ScoreSource {
  metrics
  heuristic
}

enum JobType {
  extraction
}

enum JobStatus {
  pending
  running
  completed
  failed
  canceled
}

// Fase dell'estrazione a passi (T-1201, T-1202): expand calcola le query, autocomplete e metrics lavorano a
// batch sullo staging del job, store scrive i risultati; done a job completed.
enum JobPhase {
  expand
  autocomplete
  metrics
  store
  done
}

enum UserRole {
  ADMIN
  SUBSCRIBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ThemeMode {
  DARK
  LIGHT
}

enum FontScaleMode {
  NORMAL
  LARGE
}

enum ColorVisionMode {
  NONE
  PROTANOPIA
  DEUTERANOPIA
  TRITANOPIA
}

/// Lingua dell'interfaccia scelta dall'utente (T-1301, D-07).
enum UiLocale {
  it
  en
}

/// Ruolo nel workspace (T-1501, D-08): OWNER > ADMIN > MEMBER; i permessi stanno in lib/authz/permissions.ts.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum OnboardingStatus {
  NEEDS_CHOICE
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum OnboardingStep {
  WELCOME
  PROJECT_CREATE
  PROJECT_TARGETING
  SECTION_CREATE
  SEEDS
  RUN
  REVIEW_EXPORT
}

enum OnboardingEntryMode {
  NONE
  RESUME
  RESTART
}

enum OnboardingIdempotencyKind {
  PROJECT
  SECTION
}

model User {
  id                          String                     @id @default(cuid())
  /// Identità di accesso (T-1401): sempre minuscola (vincolo CHECK users_email_lowercase, solo nella migrazione),
  /// nulla solo per gli utenti legacy creati prima dell'email, che non possono più accedere.
  email                       String?                    @unique
  email_verified_at           DateTime?
  /// Nome mostrato, non univoco (era username fino a T-1401).
  display_name                String
  password_hash               String
  role                        UserRole                   @default(SUBSCRIBER)
  status                      UserStatus                 @default(ACTIVE)
  is_root_admin               Boolean                    @default(false)
  last_login_at               DateTime?
  theme_mode                  ThemeMode                  @default(DARK)
  font_scale_mode             FontScaleMode              @default(NORMAL)
  color_vision_mode           ColorVisionMode            @default(NONE)
  /// null finché l'utente non sceglie: la lingua si risolve da cookie, Accept-Language e infine it.
  ui_locale                   UiLocale?
  session_version             Int                        @default(0)
  /// Versione dei termini accettata e momento dell'accettazione (T-1405); null finché l'utente non accetta.
  accepted_terms_version      String?
  accepted_terms_at           DateTime?
  created_at                  DateTime                   @default(now())
  updated_at                  DateTime                   @updatedAt
  /// Progetti creati dall'utente (T-1501): la proprietà è del workspace, questo è solo l'autore.
  created_projects            Project[]                  @relation("ProjectCreator")
  /// Workspace personale creato con l'utente (T-1501): uno e uno solo, mai abbandonabile dal suo OWNER.
  personal_workspace          Workspace?                 @relation("PersonalWorkspace")
  memberships                 Membership[]
  sent_workspace_invites      WorkspaceInvite[]
  google_sheets_credential    GoogleSheetsCredential?
  onboarding_progress         UserOnboardingProgress?
  onboarding_idempotency_keys OnboardingIdempotencyKey[]
  email_verification_tokens   EmailVerificationToken[]
  password_reset_tokens       PasswordResetToken[]

  // Indice unico parziale users_single_root_admin_idx (migrazione 0005): un solo root admin. Prisma non esprime
  // gli indici parziali: c'è solo nella migrazione e tests/integration/schema-indexes.test.ts ne verifica la presenza.
  @@map("users")
}

/// Workspace di team (T-1501, D-08): possiede i progetti; l'isolamento è applicativo (D-02) e passa dalla membership.
model Workspace {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String            @unique
  personal_for_user_id String?           @unique
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  personal_for_user    User?             @relation("PersonalWorkspace", fields: [personal_for_user_id], references: [id], onDelete: Cascade)
  memberships          Membership[]
  projects             Project[]
  invites              WorkspaceInvite[]
  subscription         WorkspaceSubscription?

  @@map("workspaces")
}

/// Appartenenza di un utente a un workspace con il suo ruolo (T-1501): una sola riga per coppia.
model Membership {
  id           String        @id @default(cuid())
  workspace_id String
  user_id      String
  role         WorkspaceRole
  created_at   DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@index([user_id])
  @@map("memberships")
}

/// Invito in un workspace (T-1503): email minuscola, ruolo ADMIN o MEMBER (vincoli CHECK solo nella migrazione), token
/// salvato solo come SHA-256 esadecimale, valido 7 giorni e monouso.
model WorkspaceInvite {
  id                 String        @id @default(cuid())
  workspace_id       String
  email              String
  role               WorkspaceRole
  token_hash         String        @unique @db.Char(64)
  invited_by_user_id String?
  expires_at         DateTime
  accepted_at        DateTime?
  revoked_at         DateTime?
  created_at         DateTime      @default(now())
  workspace          Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  invited_by         User?         @relation(fields: [invited_by_user_id], references: [id], onDelete: SetNull)

  @@index([workspace_id])
  @@index([email])
  @@map("workspace_invites")
}

model Project {
  id                          String                     @id @default(cuid())
  workspace_id                String
  created_by_user_id          String?
  default_subproject_id       String?
  name                        String
  language_code               String                     @default("en")
  country_code                String                     @default("US")
  /// Provider reale per default (T-1103): MOCK produce keyword fittizie (CWE-1188).
  autocomplete_provider       AutocompleteProvider       @default(GOOGLE_DIRECT)
  metrics_provider            MetricsProvider            @default(NONE)
  min_volume                  Int                        @default(0)
  exclude_brands              Boolean                    @default(true)
  expand_alpha                Boolean                    @default(true)
  expand_numeric              Boolean                    @default(true)
  expand_patterns             Boolean                    @default(true)
  auto_classification         Boolean                    @default(true)
  scoring_profile             String                     @default("balanced")
  created_at                  DateTime                   @default(now())
  updated_at                  DateTime                   @updatedAt
  /// Ultima attività reale (estrazioni, sezioni, revisione, impostazioni): ordinamento della dashboard (T-810).
  last_activity_at            DateTime                   @default(now())
  workspace                   Workspace                  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  created_by                  User?                      @relation("ProjectCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  subprojects                 Subproject[]               @relation("ProjectSubprojects")
  default_subproject          Subproject?                @relation("ProjectDefaultSubproject", fields: [default_subproject_id], references: [id], onDelete: SetNull)
  seeds                       Seed[]
  keyword_candidates          KeywordCandidate[]
  jobs                        Job[]
  brand_blacklist             BrandBlacklist[]
  expansion_patterns          ExpansionPattern[]
  metrics_provider_requests   MetricsProviderRequest[]
  onboarding_active_for_users UserOnboardingProgress[]   @relation("OnboardingActiveProject")
  onboarding_idempotency_keys OnboardingIdempotencyKey[]

  @@index([workspace_id])
  @@index([default_subproject_id])
  @@map("projects")
}

model Subproject {
  id                             String                     @id @default(cuid())
  project_id                     String
  name                           String
  description                    String?
  position                       Int                        @default(0)
  language_code_override         String?
  country_code_override          String?
  autocomplete_provider_override AutocompleteProvider?
  metrics_provider_override      MetricsProvider?
  min_volume_override            Int?
  exclude_brands_override        Boolean?
  expand_alpha_override          Boolean?
  expand_numeric_override        Boolean?
  expand_patterns_override       Boolean?
  auto_classification_override   Boolean?
  scoring_profile_override       String?
  created_at                     DateTime                   @default(now())
  updated_at                     DateTime                   @updatedAt
  project                        Project                    @relation("ProjectSubprojects", fields: [project_id], references: [id], onDelete: Cascade)
  default_for_projects           Project[]                  @relation("ProjectDefaultSubproject")
  seeds                          Seed[]
  keyword_candidates             KeywordCandidate[]
  jobs                           Job[]
  onboarding_active_for_users    UserOnboardingProgress[]   @relation("OnboardingActiveSubproject")
  onboarding_idempotency_keys    OnboardingIdempotencyKey[]

  @@unique([project_id, name])
  @@index([project_id, position])
  @@map("subprojects")
}

model Seed {
  id            String     @id @default(cuid())
  project_id    String
  subproject_id String
  keyword       String
  created_at    DateTime   @default(now())
  project       Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  subproject    Subproject @relation(fields: [subproject_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([subproject_id])
  @@map("seeds")
}

model KeywordCandidate {
  id                          String            @id @default(cuid())
  project_id                  String
  subproject_id               String
  keyword                     String
  normalized_keyword          String
  canonical_keyword           String
  source                      String
  source_query                String
  brand_status                BrandStatus       @default(allowed)
  brand_reason                String?
  review_status               ReviewStatus      @default(pending)
  selected_for_export         Boolean           @default(false)
  keyword_type                KeywordType       @default(generic)
  search_intent               SearchIntent      @default(mixed)
  is_question                 Boolean           @default(false)
  is_local_intent             Boolean           @default(false)
  is_tool_intent              Boolean           @default(false)
  is_commercial_intent        Boolean           @default(false)
  metrics_status              MetricsStatus     @default(missing)
  metrics_provider            MetricsProvider   @default(NONE)
  avg_monthly_searches        Int?
  competition                 Float?
  low_top_of_page_bid_micros  BigInt?
  high_top_of_page_bid_micros BigInt?
  metrics_precision           MetricsPrecision?
  score                       Float?
  score_source                ScoreSource       @default(heuristic)
  metrics_updated_at          DateTime?
  created_at                  DateTime          @default(now())
  updated_at                  DateTime          @updatedAt
  project                     Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  subproject                  Subproject        @relation(fields: [subproject_id], references: [id], onDelete: Cascade)

  @@unique([subproject_id, canonical_keyword])
  @@index([project_id, review_status])
  @@index([project_id, brand_status])
  @@index([project_id, search_intent])
  @@index([project_id, keyword_type])
  @@index([subproject_id, review_status])
  @@index([subproject_id, brand_status])
  @@index([subproject_id, search_intent])
  @@index([subproject_id, keyword_type])
  // Ordinamento dei risultati (RESULTS_ORDER_BY, T-707, T-801): stesso ordine e stessa posizione dei NULL (T-1103).
  @@index([project_id, score_source, score(sort: Desc), keyword, id], map: "keyword_candidates_results_order_project_idx")
  @@index([subproject_id, score_source, score(sort: Desc), keyword, id], map: "keyword_candidates_results_order_subproject_idx")
  @@map("keyword_candidates")
}

model Job {
  id               String          @id @default(cuid())
  project_id       String
  subproject_id    String
  type             JobType         @default(extraction)
  status           JobStatus       @default(pending)
  payload          Json?
  result           Json?
  error_message    String?
  started_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  // Esecuzione a passi ripartibile (T-1201): cursore della fase, avanzamento, heartbeat e lease del passo in corso.
  phase            JobPhase        @default(expand)
  cursor           Json            @default("{}")
  progress_done    Int             @default(0)
  progress_total   Int             @default(0)
  heartbeat_at     DateTime?
  locked_until     DateTime?
  attempts         Int             @default(0)
  cancel_requested Boolean         @default(false)
  project          Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  subproject       Subproject      @relation(fields: [subproject_id], references: [id], onDelete: Cascade)
  suggestions      JobSuggestion[]
  metrics          JobMetric[]

  @@index([project_id, status])
  @@index([subproject_id, status])
  @@index([status, created_at])
  // Indice unico parziale jobs_one_active_per_subproject (migrazione 0025, T-1201): al massimo un job pending o
  // running per sezione, ON jobs (subproject_id) WHERE status IN ('pending','running'). Prisma non esprime gli
  // indici parziali: c'è solo nella migrazione e tests/integration/job-model.test.ts ne verifica la presenza.
  @@map("jobs")
}

// Staging dell'autocomplete di un job (T-1201): suggerimenti per query, nell'ordine di inserimento (id).
model JobSuggestion {
  id           BigInt @id @default(autoincrement())
  job_id       String
  query_index  Int
  keyword      String
  source       String
  source_query String
  job          Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, query_index, keyword])
  @@map("job_suggestions")
}

// Staging delle metriche di un job (T-1201): una riga per canonical arricchita.
model JobMetric {
  id                          BigInt            @id @default(autoincrement())
  job_id                      String
  canonical_keyword           String
  metrics_status              MetricsStatus
  metrics_provider            MetricsProvider
  metrics_precision           MetricsPrecision?
  avg_monthly_searches        Int?
  competition                 Float?
  low_top_of_page_bid_micros  BigInt?
  high_top_of_page_bid_micros BigInt?
  job                         Job               @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, canonical_keyword])
  @@map("job_metrics")
}

model BrandBlacklist {
  id         String   @id @default(cuid())
  project_id String?
  brand      String
  reason     String?
  created_at DateTime @default(now())
  project    Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, brand])
  @@index([brand])
  // Righe globali uniche: indice unico parziale brand_blacklist_global_brand_key (brand) WHERE project_id IS NULL
  // (migrazione 0023, T-1103), non esprimibile in Prisma; l'unique sopra non vale per i NULL.
  @@map("brand_blacklist")
}

model ExpansionPattern {
  id         String   @id @default(cuid())
  project_id String?
  pattern    String
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  project    Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, pattern])
  // Righe globali uniche: indice unico parziale expansion_patterns_global_pattern_key (pattern) WHERE
  // project_id IS NULL (migrazione 0023, T-1103), non esprimibile in Prisma.
  @@map("expansion_patterns")
}

model GoogleSheetsCredential {
  id                      String    @id @default(cuid())
  user_id                 String    @unique
  connected_email         String?
  refresh_token_encrypted String
  scope                   String?
  token_type              String?
  /// invalid_grant al rinnovo del token (T-906): la credenziale va ricollegata; un nuovo consenso la azzera.
  reauth_required_at      DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  user                    User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("google_sheets_credentials")
}

model UserOnboardingProgress {
  id                   String              @id @default(cuid())
  user_id              String              @unique
  status               OnboardingStatus    @default(NEEDS_CHOICE)
  current_step         OnboardingStep      @default(WELCOME)
  entry_mode           OnboardingEntryMode @default(NONE)
  active_project_id    String?
  active_subproject_id String?
  first_export_at      DateTime?
  completed_at         DateTime?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  user                 User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  active_project       Project?            @relation("OnboardingActiveProject", fields: [active_project_id], references: [id], onDelete: SetNull)
  active_subproject    Subproject?         @relation("OnboardingActiveSubproject", fields: [active_subproject_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([current_step])
  @@index([active_project_id])
  @@index([active_subproject_id])
  @@map("user_onboarding_progress")
}

/// Chiavi di idempotenza delle creazioni dell'onboarding (T-1001): la stessa chiave dello stesso utente
/// restituisce gli id già creati invece di creare un secondo progetto o una seconda sezione.
model OnboardingIdempotencyKey {
  id            String                    @id @default(cuid())
  user_id       String
  key           String
  kind          OnboardingIdempotencyKind
  project_id    String
  subproject_id String?
  created_at    DateTime                  @default(now())
  user          User                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project       Project                   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  subproject    Subproject?               @relation(fields: [subproject_id], references: [id], onDelete: Cascade)

  @@unique([user_id, key])
  @@index([project_id])
  @@index([subproject_id])
  @@map("onboarding_idempotency_keys")
}

// Stato di una richiesta al fornitore di metriche (T-903): pending = prenotata, costo stimato.
enum MetricsRequestStatus {
  pending
  completed
  failed
}

/// Registro delle richieste al fornitore di metriche con licenza (T-903): tetti di spesa e limitatore tra istanze.
model MetricsProviderRequest {
  id                 String               @id @default(cuid())
  created_at         DateTime             @default(now())
  provider           MetricsProvider
  project_id         String?
  job_id             String?
  keyword_count      Int
  cost_usd           Decimal?             @db.Decimal(10, 4)
  estimated_cost_usd Decimal              @db.Decimal(10, 4)
  status             MetricsRequestStatus @default(pending)
  project            Project?             @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@map("metrics_provider_requests")
}

model AppSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value_encrypted String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("app_settings")
}

/// Outbox delle email transazionali (T-1402): con EMAIL_TRANSPORT=outbox (sviluppo e test) i messaggi finiscono qui
/// invece che a Resend.
model EmailOutbox {
  id         String   @id
  to_address String
  template   String
  locale     String
  subject    String
  html       String
  text       String
  created_at DateTime @default(now())

  @@index([created_at])
  @@map("email_outbox")
}

/// Token di verifica dell'email (T-1403): solo l'hash SHA-256 esadecimale del token, valido 24 h, monouso.
model EmailVerificationToken {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique @db.Char(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("email_verification_tokens")
}

/// Token di recupero password (T-1404): solo l'hash SHA-256 esadecimale del token, valido 1 h, monouso.
model PasswordResetToken {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique @db.Char(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("password_reset_tokens")
}

// Abbonamenti per workspace (T-1603): stati di Paddle Billing, aggiornati solo dai webhook firmati.
enum SubscriptionStatus {
  trialing
  active
  past_due
  paused
  canceled
}

// Esito di un evento di fatturazione (T-1603): applicato, più vecchio dello stato (stale) o ignorato.
enum BillingEventOutcome {
  applied
  stale
  ignored
}

/// Abbonamento del workspace (T-1603): una riga per workspace, legata alla subscription di Paddle. I campi di importo,
/// valuta e ciclo servono ai KPI di T-1705; past_due_since alla tolleranza dei pagamenti scaduti (T-1604).
model WorkspaceSubscription {
  id                       String             @id @default(cuid())
  workspace_id             String             @unique
  provider                 String
  provider_subscription_id String             @unique
  provider_customer_id     String
  plan_id                  String
  status                   SubscriptionStatus
  current_period_start     DateTime?
  current_period_end       DateTime?
  cancel_at                DateTime?
  past_due_since           DateTime?
  currency_code            String?
  recurring_amount_minor   BigInt?
  billing_interval         String?
  billing_frequency        Int?
  quantity                 Int?
  last_event_occurred_at   DateTime
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt
  workspace                Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("workspace_subscriptions")
}

/// Registro dei webhook di fatturazione (T-1603): un evento per event_id, così una consegna ripetuta non ha effetti.
model BillingEvent {
  id              String              @id @default(cuid())
  event_id        String              @unique
  event_type      String
  occurred_at     DateTime
  notification_id String?
  outcome         BillingEventOutcome
  payload         Json
  created_at      DateTime            @default(now())

  @@map("billing_events")
}
