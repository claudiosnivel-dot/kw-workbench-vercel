# Configurazione validata all'avvio da lib/env.ts (T-201): con un valore non ammesso il server
# non parte e l'errore nomina la variabile, mai il valore.
# Interi: assente o vuoto -> default; non intero (abc, 6x, 1.5) -> errore; fuori intervallo ->
# riportato nell'intervallo indicato accanto alla variabile.

# Runtime (su Vercel NODE_ENV=production vale anche per i deploy Preview)
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Autenticazione app (multi-account): solo 0, false, no, off la disattivano; ogni altro valore,
# refusi compresi, la lascia attiva. In produzione disattivarla e un errore di configurazione.
APP_AUTH_ENABLED=true
# Email del root admin (obbligatoria in produzione). Con il database utenti vuoto il primo accesso crea il root admin
# con questa email e una password casuale: si entra impostando la password da "Password dimenticata?".
APP_ADMIN_EMAIL=
# Registrazione pubblica SaaS (true=abilitata, false=solo creazione da dashboard admin)
APP_PUBLIC_SIGNUP_ENABLED=true
# APP_SESSION_SECRET e APP_ENCRYPTION_KEY: senza default, vanno impostate in ogni ambiente; in
# produzione almeno 32 caratteri e diverse dai segnaposto qui sotto (openssl rand -hex 32).
APP_SESSION_SECRET=replace-with-a-long-random-session-secret
# Intero tra 60 e 31536000 (default 604800, 7 giorni)
APP_SESSION_MAX_AGE_SECONDS=604800
APP_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# Cookie secure: auto = true in production, false in locale
APP_COOKIE_SECURE=auto

# Branding opzionale (override iniziale, modificabile anche da UI)
APP_BRAND_NAME=Seo God Mode
APP_BRAND_LOGO_URL=
APP_BRAND_LOGO_URL_DARK=
APP_BRAND_LOGO_URL_LIGHT=

# Database PostgreSQL locale (senza Docker)
# Assicurati di avere un server PostgreSQL attivo su localhost:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kw_workbench?schema=public
# DIRECT_URL e usato da Prisma migrate/seed (su locale puo coincidere con DATABASE_URL)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/kw_workbench?schema=public

# Produzione (Vercel + Supabase consigliato):
# DATABASE_URL  -> Transaction pooler (porta 6543) con pgbouncer e connection_limit basso
# DIRECT_URL    -> Session mode / direct (porta 5432) per migrate e seed
# DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=3
# DIRECT_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# Usati solo con il pooler Supabase. PRISMA_CONNECTION_LIMIT: intero tra 1 e 50 (default 3 in
# produzione, 1 altrove); PRISMA_POOL_TIMEOUT: secondi, intero tra 1 e 120 (default 15).
PRISMA_CONNECTION_LIMIT=3
PRISMA_POOL_TIMEOUT=15

# Solo nell'ambiente Preview di Vercel (T-202): identita del DB di produzione, come host oppure
# utente@host (pooler Supabase: postgres.<PROJECT-REF>@aws-1-<REGION>.pooler.supabase.com).
# Il build di Preview applica migrazioni e seed solo se DIRECT_URL punta a un DB diverso;
# se la variabile manca le salta. Mai impostarla in Production.
PRODUCTION_DB_HOST=

# Estrazione: intero tra 50 e 5000 (default 250)
MAX_EXPANSION_QUERIES=250
# Timeout in ms della transazione che salva i risultati: intero tra 5000 e 300000 (default 60000)
EXTRACTION_TX_TIMEOUT_MS=60000
# Estrazione a passi (T-1202): query di autocomplete per batch, intero tra 1 e 500 (default 24), e durata di un
# passo del job in ms, intero tra 5000 e 240000 (default 60000)
JOB_AUTOCOMPLETE_BATCH=24
JOB_STEP_BUDGET_MS=60000
# Recupero dei job (T-1203): heartbeat fermo oltre il quale il job è bloccato, intero tra 35000 e 3600000 (default
# 180000, almeno JOB_STEP_BUDGET_MS + 30000), e tentativi massimi, intero tra 1 e 20 (default 5)
JOB_STALE_AFTER_MS=180000
JOB_MAX_ATTEMPTS=5
# Firma HMAC delle chiamate interne dei job: almeno 32 caratteri, diversa da APP_SESSION_SECRET, obbligatoria in
# produzione (openssl rand -hex 32). Senza, in sviluppo i job non proseguono oltre il primo passo.
JOB_SIGNING_SECRET=
# Segreto del cron di Vercel (almeno 16 caratteri); senza, /api/cron/reap-jobs risponde 401.
CRON_SECRET=
# URL pubblico dell'app: base dei link nelle email e delle chiamate interne fuori da Vercel (https; http solo per
# localhost). Obbligatorio in produzione.
APP_PUBLIC_URL=http://localhost:3000
# Email transazionali: resend in produzione (obbligatorio), outbox altrove (default: messaggi nella tabella
# email_outbox, nessun invio). Con resend servono RESEND_API_KEY ed EMAIL_FROM, su un dominio verificato in Resend.
EMAIL_TRANSPORT=outbox
RESEND_API_KEY=
EMAIL_FROM=

# Tuning provider autocomplete (interi; default e intervallo):
# AUTOCOMPLETE_TIMEOUT_MS 4500 [1000, 30000]; AUTOCOMPLETE_MAX_RETRIES 2 [0, 5];
# AUTOCOMPLETE_RATE_LIMIT_MS 180 [50, 10000]; AUTOCOMPLETE_CACHE_TTL_MS 300000 [30000, 86400000];
# AUTOCOMPLETE_CONCURRENCY 6 [1, 20]
AUTOCOMPLETE_TIMEOUT_MS=4500
AUTOCOMPLETE_MAX_RETRIES=2
AUTOCOMPLETE_RATE_LIMIT_MS=180
AUTOCOMPLETE_CACHE_TTL_MS=300000
AUTOCOMPLETE_CONCURRENCY=6
GOOGLE_AUTOCOMPLETE_ENDPOINT=https://suggestqueries.google.com/complete/search
GOOGLE_AUTOCOMPLETE_CLIENT=firefox


# Fornitore di metriche con licenza DataForSEO (T-902, D-30): credenziali dell'account API
# (https://app.dataforseo.com/api-access). Vuote = provider DATAFORSEO non configurato, nessuna chiamata.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Timeout per richiesta e tentativi per lotto (default 30000 e 3).
DATAFORSEO_TIMEOUT_MS=
DATAFORSEO_MAX_ATTEMPTS=
# Tetti di spesa del fornitore di metriche in USD (T-903): 0 = nessuna spesa ammessa (default).
METRICS_MONTHLY_BUDGET_USD=0
METRICS_RUN_BUDGET_USD=0
# Costo stimato per richiesta live, prenotato prima dell'invio (default 0.09).
METRICS_COST_PER_REQUEST_USD=

# Configurazione opzionale Google Sheets OAuth (per export utenti)
# Questi valori sono configurabili anche da Dashboard Admin (solo root admin)
GOOGLE_SHEETS_OAUTH_CLIENT_ID=
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=
# Locale: http://localhost:3000/api/integrations/google-sheets/callback
# Produzione: https://<tuo-dominio>/api/integrations/google-sheets/callback
GOOGLE_SHEETS_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-sheets/callback

# Sentry (T-601, D-13): senza DSN l'SDK non si inizializza e non fa richieste di rete.
# SENTRY_DSN per server ed edge, NEXT_PUBLIC_SENTRY_DSN per il browser (formato https://<chiave>@<host>/<progetto>).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Solo in build, per caricare le source map: senza token il caricamento si salta e la build prosegue.
# Mai con prefisso NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Livello minimo del logger JSON (T-602): debug, info, warn o error (default info).
LOG_LEVEL=info
