{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": true,
  "playwright": {
    "config": [],
    "entry": [
      "tests/e2e/**/*.spec.ts",
      "tests/e2e/global-setup.ts"
    ]
  },
  "entry": [
    "app/**/{page,layout,route}.{ts,tsx}",
    "proxy.ts",
    "prisma/seed.ts",
    "scripts/**/*.{mjs,ts}",
    "prisma.config.ts",
    "next.config.ts",
    "tailwind.config.ts",
    "postcss.config.js",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "prisma/**/*.ts",
    "scripts/**/*.{mjs,ts}",
    "tests/**/*.{ts,tsx}"
  ],
  "ignore": [
    "tests/fixtures/tooling/**",
    "lib/generated/**"
  ],
  "ignoreDependencies": [
    "eslint-config-next",
    "jscpd",
    "@prisma/client"
  ],
  "ignoreExportsUsedInFile": true
}
